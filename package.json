{
  "name": "n8n-nodes-buzz-relay",
  "version": "1.0.0",
  "description": "Unofficial custom n8n node for Block's Buzz (Nostr) relays \u2014 messages, threads, reactions, channels, users, presence, files and canvases, plus a realtime trigger. For self-hosted n8n. Not affiliated with Block or n8n.",
  "license": "MIT",
  "author": {
    "name": "denizkin",
    "url": "https://github.com/denizkin28"
  },
  "homepage": "https://github.com/denizkin28/n8n-nodes-buzz-relay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denizkin28/n8n-nodes-buzz-relay.git"
  },
  "bugs": {
    "url": "https://github.com/denizkin28/n8n-nodes-buzz-relay/issues"
  },
  "keywords": [
    "n8n",
    "n8n-node",
    "buzz",
    "nostr",
    "chat",
    "automation"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "nodes",
    "credentials",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "for t in test/*.test.js; do node \"$t\" || exit 1; done"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "credentials/BuzzApi.credentials.js"
    ],
    "nodes": [
      "nodes/Buzz/Buzz.node.js",
      "nodes/BuzzTrigger/BuzzTrigger.node.js"
    ]
  },
  "dependencies": {
    "nostr-tools": "^2.24.1"
  },
  "private": true
}
